# Local CPU smoke configuration for the Phase 1 guitar pilot.
#
# Load after train.gin, model.gin and local_tiny.gin. This run verifies the
# complete local path only; its three steps are not an accuracy experiment.

from mt3 import network
from t5x import utils

TASK_PREFIX = 'guitar_pilot_notes_ties'
NUM_VELOCITY_BINS = 1
PROGRAM_GRANULARITY = 'full'
USE_CACHED_TASKS = False

# Orbax on this local stack requires an absolute checkpoint path.
MODEL_DIR = '/Users/marek/projects/transcription/runs/guitar_pilot_heldout_smoke_v1'
TASK_FEATURE_LENGTHS = {'inputs': 8, 'targets': 64}
TRAIN_STEPS = 3
EVAL_STEPS = 1
BATCH_SIZE = 1

# local_tiny.gin configures T5X's example network. MT3 uses its own Transformer
# implementation, so repeat the tiny override for that model here.
mt3.network.Transformer.config = @mt3.network.T5Config()
mt3.network.T5Config:
  dtype = 'float32'
  emb_dim = 8
  num_heads = 4
  num_encoder_layers = 2
  num_decoder_layers = 2
  head_dim = 3
  mlp_dim = 16
  mlp_activations = ('gelu', 'linear')
  dropout_rate = 0.0
  logits_via_embedding = False

train/utils.DatasetConfig.batch_size = 1
train_eval/utils.DatasetConfig.batch_size = 1
infer_eval/utils.DatasetConfig.batch_size = 1
utils.SaveCheckpointConfig.period = 3
